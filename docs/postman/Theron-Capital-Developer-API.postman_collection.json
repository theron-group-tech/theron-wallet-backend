{
  "info": {
    "_postman_id": "f4f0d5b6-4d7d-4c62-a3d0-theron-capital-dev-api",
    "name": "Theron Capital - Developer API",
    "description": "Integração da organização cliente com a Theron Capital.\n\nA Theron cria a Organização e o Owner. O Owner faz login, cria a Theron API Key e a integração passa a operar com Bearer tk_sandbox_… / tk_live_….\n\nVARIÁVEIS\nPreencha só email e password (e pixDestinationKey para PIX de saída). O script de Tests da collection grava o restante após cada resposta 2xx: accessToken, organizationId, ownerAccountId, apiKey, apiKeyId, managedAccountId, walletId, pixKeyId, chargeId, etc.\n\nAUTH\n- Pastas 01 e 02: Bearer {{accessToken}} (JWT OWNER)\n- Pastas 03–07: Bearer {{apiKey}} (auth da collection)\n- GET /accounts/{id}/statement exige JWT do OWNER\n\nOrdem: 01 Bootstrap → 02 Create API Key → 03+ com a chave.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://theron-wallet-backend-production.up.railway.app", "type": "string" },
    { "key": "email", "value": "SEU_OWNER_EMAIL", "type": "string" },
    { "key": "password", "value": "SUA_SENHA_OWNER", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "apiKey", "value": "", "type": "string" },
    { "key": "apiKeyId", "value": "", "type": "string" },
    { "key": "organizationId", "value": "", "type": "string" },
    { "key": "ownerAccountId", "value": "", "type": "string" },
    { "key": "managedAccountId", "value": "", "type": "string" },
    { "key": "managedUserId", "value": "", "type": "string" },
    { "key": "walletId", "value": "", "type": "string" },
    { "key": "managedWalletId", "value": "", "type": "string" },
    { "key": "pixKeyId", "value": "", "type": "string" },
    { "key": "pixKey", "value": "", "type": "string" },
    { "key": "pixDestinationKey", "value": "CHAVE_PIX_DESTINO", "type": "string" },
    { "key": "pixTransferId", "value": "", "type": "string" },
    { "key": "pixAsaasTransactionId", "value": "", "type": "string" },
    { "key": "chargeId", "value": "", "type": "string" },
    { "key": "transactionId", "value": "", "type": "string" },
    { "key": "anticipationId", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function setVar(key, value) {",
          "  if (value === undefined || value === null || value === '') return;",
          "  pm.collectionVariables.set(key, String(value));",
          "}",
          "function body() {",
          "  try { return pm.response.json(); } catch (e) { return null; }",
          "}",
          "function first(list) {",
          "  return Array.isArray(list) && list.length ? list[0] : null;",
          "}",
          "",
          "if (pm.response.code >= 400) { return; }",
          "const j = body();",
          "if (!j) { return; }",
          "const name = pm.info.requestName;",
          "",
          "if (name === 'Login Owner') {",
          "  setVar('accessToken', j.accessToken || j.token);",
          "}",
          "",
          "if (name === 'Get Me') {",
          "  const org = first(j.organizations);",
          "  if (org) setVar('organizationId', org.organizationId);",
          "}",
          "",
          "if (name === 'Get Organization') {",
          "  setVar('organizationId', j.id);",
          "}",
          "",
          "if (name === 'List Owner Accounts' || name === 'List Managed Accounts') {",
          "  const list = Array.isArray(j) ? j : (j.content || j.items || []);",
          "  const owner = list.find((a) => a.type === 'MAIN') || list[0];",
          "  const managed = list.find((a) => a.type && a.type !== 'MAIN');",
          "  if (owner) {",
          "    setVar('ownerAccountId', owner.id);",
          "    setVar('organizationId', owner.organizationId);",
          "  }",
          "  if (managed) {",
          "    setVar('managedAccountId', managed.id);",
          "    setVar('managedWalletId', managed.asaasWalletId);",
          "    setVar('organizationId', managed.organizationId);",
          "  }",
          "}",
          "",
          "if (name === 'Get Owner Account' || name === 'Get Account') {",
          "  setVar('ownerAccountId', j.id);",
          "  setVar('organizationId', j.organizationId);",
          "}",
          "",
          "if (name === 'Create API Key' || name === 'Rotate API Key') {",
          "  setVar('apiKey', j.apiKey);",
          "  setVar('apiKeyId', j.id);",
          "  setVar('organizationId', j.organizationId);",
          "  setVar('ownerAccountId', j.accountId);",
          "}",
          "",
          "if (name === 'Create Finance or Employee') {",
          "  setVar('managedUserId', j.userId);",
          "  setVar('organizationId', j.organizationId);",
          "  if (j.account) {",
          "    setVar('managedAccountId', j.account.id);",
          "    setVar('managedWalletId', j.account.asaasWalletId);",
          "  }",
          "  if (j.asaasBind && j.asaasBind.asaasWalletId) {",
          "    setVar('managedWalletId', j.asaasBind.asaasWalletId);",
          "  }",
          "}",
          "",
          "if (name === 'Get Managed Account') {",
          "  setVar('managedAccountId', j.id);",
          "  setVar('managedWalletId', j.asaasWalletId);",
          "  setVar('organizationId', j.organizationId);",
          "}",
          "",
          "if (name === 'Get Wallet' || name === 'Get Wallet Direct' || name === 'Get Managed Wallet') {",
          "  const wallet = j.wallet || j;",
          "  setVar('walletId', wallet.id);",
          "  if (name === 'Get Managed Wallet') setVar('managedAccountId', wallet.accountId);",
          "}",
          "",
          "if (name === 'Get Statement' || name === 'List Transactions') {",
          "  const row = first(j.content || j.items || []);",
          "  if (row) setVar('transactionId', row.id);",
          "}",
          "",
          "if (name === 'Get Transaction') {",
          "  setVar('transactionId', j.id);",
          "}",
          "",
          "if (name === 'Create EVP Key') {",
          "  setVar('pixKeyId', j.id);",
          "  setVar('pixKey', j.key);",
          "}",
          "",
          "if (name === 'List PIX Keys') {",
          "  const key = first(Array.isArray(j) ? j : (j.content || []));",
          "  if (key) {",
          "    setVar('pixKeyId', key.id);",
          "    setVar('pixKey', key.key);",
          "  }",
          "}",
          "",
          "if (name === 'Create PIX Transfer' || name === 'Get PIX Transfer') {",
          "  setVar('pixTransferId', j.id);",
          "  setVar('transactionId', j.transactionId);",
          "}",
          "",
          "if (name === 'List PIX Transfers') {",
          "  const row = first(j.content || j.items || []);",
          "  if (row) setVar('pixTransferId', row.id);",
          "}",
          "",
          "if (name === 'Pay PIX QR Code') {",
          "  setVar('pixAsaasTransactionId', j.id);",
          "  setVar('transactionId', j.transactionId);",
          "}",
          "",
          "if (name === 'Create Boleto Charge' || name === 'Create Credit Card Charge with Split' || name === 'Create PIX Charge' || name === 'Get Charge') {",
          "  setVar('chargeId', j.id);",
          "}",
          "",
          "if (name === 'List Charges') {",
          "  const row = first(j.content || j.items || []);",
          "  if (row) setVar('chargeId', row.id);",
          "}",
          "",
          "if (name === 'Simulate Anticipation' || name === 'Create Anticipation' || name === 'Get Anticipation') {",
          "  setVar('anticipationId', j.id);",
          "}",
          "",
          "if (name === 'List Anticipations') {",
          "  const row = first(j.content || j.items || []);",
          "  if (row) setVar('anticipationId', row.id);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Bootstrap",
      "item": [
        {
          "name": "Login Owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login Owner 200', () => pm.response.to.have.status(200));",
                  "pm.test('accessToken gravado', () => pm.expect(pm.collectionVariables.get('accessToken')).to.be.ok);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"platform\": \"web\",\n  \"deviceId\": \"postman-developer-api\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Login do OWNER. Grava accessToken automaticamente."
          }
        },
        {
          "name": "Get Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get Me 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/me",
            "description": "Perfil do OWNER. Grava organizationId a partir de organizations[0]."
          }
        },
        {
          "name": "Get Organization",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get Organization 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/organization",
            "description": "Organização do JWT. Grava organizationId."
          }
        },
        {
          "name": "List Owner Accounts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('List Owner Accounts 200', () => pm.response.to.have.status(200));",
                  "pm.test('ownerAccountId gravado', () => pm.expect(pm.collectionVariables.get('ownerAccountId')).to.be.ok);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/organization/accounts",
            "description": "Lista as Accounts do OWNER autenticado. Grava ownerAccountId (type MAIN)."
          }
        },
        {
          "name": "Get Owner Account",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/accounts/{{ownerAccountId}}",
            "description": "Confirma a Account financeira do OWNER. Regrava ownerAccountId e organizationId."
          }
        }
      ]
    },
    {
      "name": "02 - Theron API Key",
      "item": [
        {
          "name": "Create API Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create API Key 201', () => pm.response.to.have.status(201));",
                  "pm.test('apiKey tk_ gravada', () => pm.expect(pm.collectionVariables.get('apiKey')).to.match(/^tk_(sandbox|live)_/));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ERP / Marketplace\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/developer/api-keys",
            "description": "OWNER only. Grava apiKey (plaintext uma vez), apiKeyId, organizationId e ownerAccountId."
          }
        },
        {
          "name": "List API Keys",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/developer/api-keys",
            "description": "Lista metadados. Não devolve o segredo plaintext."
          }
        },
        {
          "name": "Rotate API Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rotate API Key 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/developer/api-keys/{{apiKeyId}}/rotate",
            "description": "Invalida o segredo anterior e grava o novo em apiKey. Rode só no final dos testes."
          }
        },
        {
          "name": "Revoke API Key",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/developer/api-keys/{{apiKeyId}}",
            "description": "Revoga a credencial. Rode só no final dos testes."
          }
        }
      ]
    },
    {
      "name": "03 - Managed Accounts",
      "item": [
        {
          "name": "List Managed Accounts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/organization/accounts",
            "description": "Com API Key, retorna o Owner e as contas FINANCE/EMPLOYEE no escopo. Grava ownerAccountId e managedAccountId."
          }
        },
        {
          "name": "Create Finance or Employee",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create member 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Financeiro Teste\",\n  \"email\": \"financeiro.{{$guid}}@empresa.com.br\",\n  \"phone\": \"11999999999\",\n  \"password\": \"SenhaForte123!\",\n  \"role\": \"FINANCE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/organization/members",
            "description": "Cria User + Membership + Account + Wallet. Grava managedAccountId, managedUserId e managedWalletId (asaasWalletId, se já existir)."
          }
        },
        {
          "name": "Get Managed Account",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/organization/accounts/{{managedAccountId}}",
            "description": "Consulta a Account gerenciada. Regrava managedAccountId e managedWalletId."
          }
        },
        {
          "name": "Get Managed Wallet",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/accounts/{{managedAccountId}}/wallet",
            "description": "Wallet Theron da Account gerenciada."
          }
        },
        {
          "name": "Get Managed Account Onboarding",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/organization/accounts/{{managedAccountId}}/asaas/onboarding",
            "description": "Consulta o onboarding Asaas da Account gerenciada."
          }
        },
        {
          "name": "Submit Managed Account Onboarding",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"personType\": \"COMPANY\",\n  \"business\": {\n    \"cnpj\": \"60746948000112\",\n    \"legalName\": \"Empresa Finance Teste LTDA\",\n    \"tradeName\": \"Finance Teste\",\n    \"email\": \"financeiro@empresa.com.br\",\n    \"mobilePhone\": \"11999999999\",\n    \"companyType\": \"LIMITED\"\n  },\n  \"address\": {\n    \"address\": \"Avenida Paulista\",\n    \"addressNumber\": \"1000\",\n    \"province\": \"Bela Vista\",\n    \"postalCode\": \"01311000\",\n    \"city\": \"São Paulo\",\n    \"complement\": \"Sala 10\"\n  },\n  \"financial\": {\n    \"incomeValue\": 10000\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/organization/accounts/{{managedAccountId}}/asaas/onboarding",
            "description": "One-shot KYC da Account gerenciada. Use uma Account ainda sem subconta e uma Idempotency-Key nova. Substitua o CNPJ de exemplo."
          }
        },
        {
          "name": "Get Managed Asaas Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/organization/accounts/{{managedAccountId}}/asaas/subaccount/status",
            "description": "Status da subconta Asaas. PIX/charges exigem financialResourcesEnabled=true."
          }
        }
      ]
    },
    {
      "name": "04 - Account / Wallet / Statement",
      "item": [
        {
          "name": "Get Account",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/accounts/{{ownerAccountId}}",
            "description": "Dados da Account do Owner no escopo da API Key."
          }
        },
        {
          "name": "Get Wallet",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get Wallet 200', () => pm.response.to.have.status(200));",
                  "pm.test('walletId gravado', () => pm.expect(pm.collectionVariables.get('walletId')).to.be.ok);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/accounts/{{ownerAccountId}}/wallet",
            "description": "Wallet da Account do Owner. Grava walletId (UUID Theron)."
          }
        },
        {
          "name": "Get Wallet Direct",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/wallets/{{walletId}}",
            "description": "Wallet por ID, respeitando o escopo da API Key."
          }
        },
        {
          "name": "Get Statement",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/accounts/{{ownerAccountId}}/statement?page=0&size=20",
            "description": "Extrato paginado. Esta rota exige JWT do OWNER (não API Key). Grava transactionId se houver itens."
          }
        },
        {
          "name": "List Transactions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/transactions?walletId={{walletId}}&page=0&size=20",
            "description": "Extrato por walletId. Rode Get Wallet antes. Grava transactionId."
          }
        },
        {
          "name": "Get Transaction",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/transactions/{{transactionId}}",
            "description": "Detalhe de uma transação."
          }
        }
      ]
    },
    {
      "name": "05 - PIX",
      "item": [
        {
          "name": "Create EVP Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create PIX key 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{ownerAccountId}}\",\n  \"type\": \"EVP\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/pix/keys",
            "description": "Cria chave PIX EVP. Grava pixKeyId e pixKey."
          }
        },
        {
          "name": "List PIX Keys",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/pix/keys?accountId={{ownerAccountId}}",
            "description": "Lista chaves PIX. Grava pixKeyId e pixKey da primeira chave."
          }
        },
        {
          "name": "Lookup PIX Key",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/pix/keys/lookup?accountId={{ownerAccountId}}&type=EVP&key={{pixDestinationKey}}",
            "description": "Consulta destinatário. Use pixDestinationKey (destino), não a EVP recém-criada."
          }
        },
        {
          "name": "Delete PIX Key",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/pix/keys/{{pixKeyId}}",
            "description": "Remove a chave PIX gravada em pixKeyId."
          }
        },
        {
          "name": "Create PIX Transfer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('PIX transfer accepted', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{ownerAccountId}}\",\n  \"amount\": 10.00,\n  \"destinationPixKey\": \"{{pixDestinationKey}}\",\n  \"destinationPixKeyType\": \"EVP\",\n  \"description\": \"Teste\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/pix/transfers",
            "description": "Transferência PIX. Grava pixTransferId. Preencha pixDestinationKey antes."
          }
        },
        {
          "name": "List PIX Transfers",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/pix/transfers?accountId={{ownerAccountId}}&page=0&size=20",
            "description": "Lista transferências. Grava pixTransferId da primeira."
          }
        },
        {
          "name": "Get PIX Transfer",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/pix/transfers/{{pixTransferId}}",
            "description": "Detalhe da transferência PIX."
          }
        },
        {
          "name": "Create PIX QR Code",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{ownerAccountId}}\",\n  \"pixKeyId\": \"{{pixKeyId}}\",\n  \"value\": 100.00,\n  \"description\": \"Cobrança PIX\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/pix/qr-codes",
            "description": "Gera QR Code PIX estático. Rode Create EVP Key antes."
          }
        },
        {
          "name": "Pay PIX QR Code",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{ownerAccountId}}\",\n  \"payload\": \"000201...\",\n  \"amount\": 10.00,\n  \"description\": \"Pagamento QR\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/pix/qr-codes/pay",
            "description": "Paga QR copia e cola. Grava pixAsaasTransactionId. Substitua payload pelo EMV real."
          }
        },
        {
          "name": "Get PIX Transaction",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/pix/transactions/{{pixAsaasTransactionId}}?accountId={{ownerAccountId}}",
            "description": "Poll do id Asaas gravado em pixAsaasTransactionId após Pay PIX QR Code."
          }
        }
      ]
    },
    {
      "name": "06 - Charges and Split",
      "item": [
        {
          "name": "Create PIX Charge",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Charge PIX 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"name\": \"Cliente Teste\",\n    \"cpfCnpj\": \"52998224725\",\n    \"email\": \"cliente@exemplo.com\"\n  },\n  \"value\": 50.00,\n  \"billingType\": \"PIX\",\n  \"dueDate\": \"2030-12-31\",\n  \"description\": \"Cobrança PIX\",\n  \"externalReference\": \"pm-pix-{{$timestamp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/charges",
            "description": "Cria cobrança PIX. Grava chargeId. Não envie accountId no body."
          }
        },
        {
          "name": "Create Boleto Charge",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"name\": \"Cliente Teste\",\n    \"cpfCnpj\": \"52998224725\",\n    \"email\": \"cliente@exemplo.com\",\n    \"phone\": \"11999999999\"\n  },\n  \"value\": 100.00,\n  \"billingType\": \"BOLETO\",\n  \"dueDate\": \"2030-12-31\",\n  \"description\": \"Cobrança boleto\",\n  \"externalReference\": \"pm-boleto-{{$timestamp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/charges",
            "description": "Cria cobrança por boleto. Grava chargeId."
          }
        },
        {
          "name": "Create Credit Card Charge with Split",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"name\": \"Cliente Teste\",\n    \"cpfCnpj\": \"52998224725\",\n    \"email\": \"cliente@exemplo.com\",\n    \"phone\": \"11999999999\"\n  },\n  \"value\": 500.00,\n  \"billingType\": \"CREDIT_CARD\",\n  \"dueDate\": \"2030-12-31\",\n  \"description\": \"Venda com split\",\n  \"externalReference\": \"pm-split-{{$timestamp}}\",\n  \"installments\": 1,\n  \"split\": [\n    {\n      \"walletId\": \"{{managedWalletId}}\",\n      \"percentualValue\": 20.0\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/charges",
            "description": "Split usa managedWalletId (wallet Asaas da conta gerenciada), não o UUID Theron."
          }
        },
        {
          "name": "List Charges",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/charges?page=0&size=20",
            "description": "Lista cobranças. Grava chargeId da primeira se ainda vazio."
          }
        },
        {
          "name": "Get Charge",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/charges/{{chargeId}}",
            "description": "Detalha a cobrança gravada em chargeId."
          }
        },
        {
          "name": "Cancel Charge",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/charges/{{chargeId}}/cancel",
            "description": "Cancela cobrança elegível."
          }
        }
      ]
    },
    {
      "name": "07 - Anticipations",
      "item": [
        {
          "name": "Simulate Anticipation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chargeIds\": [\"{{chargeId}}\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/anticipations/simulate",
            "description": "Simula antecipação. Grava anticipationId. No sandbox Asaas pode falhar; use create/list."
          }
        },
        {
          "name": "Create Anticipation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chargeIds\": [\"{{chargeId}}\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/anticipations",
            "description": "Solicita antecipação. Grava anticipationId."
          }
        },
        {
          "name": "List Anticipations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/anticipations?page=0&size=20",
            "description": "Lista antecipações. Grava anticipationId da primeira."
          }
        },
        {
          "name": "Get Anticipation",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/anticipations/{{anticipationId}}",
            "description": "Consulta a antecipação gravada em anticipationId."
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{apiKey}}", "type": "string" }
    ]
  }
}
